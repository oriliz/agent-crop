{
  "description": "AI coding efficiency probe hooks",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "KIT_HOST=claude-code python3 \"${CLAUDE_PLUGIN_ROOT}/core/probe_hook.py\" session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KIT_HOST=claude-code python3 \"${CLAUDE_PLUGIN_ROOT}/core/probe_hook.py\" user-prompt-submit",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "KIT_HOST=claude-code python3 \"${CLAUDE_PLUGIN_ROOT}/core/probe_hook.py\" post-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KIT_HOST=claude-code python3 \"${CLAUDE_PLUGIN_ROOT}/core/probe_hook.py\" stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "KIT_HOST=claude-code python3 \"${CLAUDE_PLUGIN_ROOT}/core/probe_hook.py\" session-end",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
