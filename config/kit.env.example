# 套件配置模板：复制为 $IDE_HOME/task-metrics/kit.env 后按需修改。
# 全部可选项，留空即用默认值。

# 记账与决策数据落点（默认 $IDE_HOME/task-metrics/data）
#KIT_DATA_DIR=

# Claude Code / DSH 双宿主：共享数据根（默认 ~/.agentcrop）
# 设置后数据写到 $KIT_SHARED_HOME/data，Claude 与 DSH 可直接对比
#KIT_SHARED_HOME=

# 宿主名，由插件自动设置：claude-code / dsh / qoder / codex
#KIT_HOST=

# 真实任务探针：红线分钟数与提醒间隔
#KIT_TASK_RED_MIN=30
#KIT_TASK_REMIND_MIN=15

# 是否让 AI 在报告时对用户说一句简短状态（1/0）
#KIT_USER_FACING=1

# 黄线：单任务块超过该分钟数即计入日报（不告警）
#KIT_YELLOW_MIN=10

# 红线：超过该分钟数注入强制复盘指令
#KIT_RED_MIN=30

# 多机协同：对端名称与 ssh 目标，留空即关闭对端合并
#KIT_PEER_NAME=
#KIT_PEER_SSH=
# 对端直连网段前缀（如该机通过雷雳/直连网卡互通），仅用于备用链路探测
#KIT_PEER_TB_PREFIX=
