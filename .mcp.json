{
  "mcpServers": {
    "probe": {
      "type": "stdio",
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/core/probe_mcp_server.py"],
      "env": {
        "KIT_HOST": "claude-code",
        "KIT_DATA_DIR": "${KIT_DATA_DIR:-}",
        "KIT_SHARED_HOME": "${KIT_SHARED_HOME:-}"
      }
    }
  }
}
